# Get your bot token from @BotFather. Never commit the actual token.
BOT_TOKEN=put_your_token_here

# Your numeric Telegram account ID, obtained from @userinfobot.
# Enables /meme_queue approval/rejection of downloaded third-party memes.
ADMIN_IDS=

# Public source discovery to the private review queue every 24h.
MEME_AUTO_DISCOVERY=1

# OPTIONAL, separately billed API: generates and edits new *original* jokes daily.
# ChatGPT Plus does not include API credits. Leave disabled for free offline mode.
MEME_AI_AUTOGEN=0
OPENAI_API_KEY=
MEME_AI_MODEL=gpt-4o-mini

# OPTIONAL extra paid API calls: inspect up to 6 external meme thumbnails per harvest.
# Helps rank humour and readability, but is not a copyright check.
MEME_AI_VISION=0
