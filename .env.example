# Get your bot token from @BotFather. Never commit the actual token.
BOT_TOKEN=put_your_token_here

# Your numeric Telegram account ID, obtained from @userinfobot.
# Enables /meme_queue approval/rejection of downloaded third-party memes.
ADMIN_IDS=

# Public source discovery to the private review queue every 24h.
MEME_AUTO_DISCOVERY=1

# OPTIONAL, separately billed API: generates and edits new *original* jokes daily.
# ChatGPT Plus does not include API credits. Leave disabled for free offline mode.
MEME_AI_AUTOGEN=0
OPENAI_API_KEY=
MEME_AI_MODEL=gpt-4o-mini

# OPTIONAL extra paid API calls: inspect up to 6 external meme thumbnails per harvest.
# Helps rank humour and readability, but is not a copyright check.
MEME_AI_VISION=0

# Old text-on-colour-card auto-memes are disabled in redesigned UX.
# Only set to 1 if you explicitly want the previous card format.
MEME_LEGACY_CARDS=0

# v4: Real photographic memes. The free Imgflip /get_memes API does NOT need a key.
# Premium API search is OPTIONAL and billed by Imgflip, disabled by default.
IMGFLIP_API_KEY=
MEME_PREMIUM_SEARCH=0
MEME_PREMIUM_TERMS=пошалим;русский мем

# OPTIONAL: new fictional, low-fi meme photograph from OpenAI Image API.
# This uses separate paid API billing; ChatGPT Plus is not API credit.
# Never enable unless you understand charges. Hard maximum: 2/day by default.
MEME_AI_ENABLED=0
MEME_AI_DAILY_LIMIT=2
MEME_IMAGE_MODEL=gpt-image-2.5-flare

# For best Russian retro memes, send original/permission-cleared photographs
# to the bot as admin with /addmeme meph ex YES.

# Unlimited local bank of real people's meme frames. No count cap; disk space
# and Telegram's ~20MB bot-file download limit still apply.
# Vision metadata is OFF by default. When enabled, frame previews are sent
# to the image-analysis provider (never user medical/checklist data).
# This costs separately from ChatGPT Plus. Every daily request is reserved.
REACTION_VISION_ENABLED=0
REACTION_VISION_MODEL=gpt-4.1-mini
REACTION_VISION_DAILY_LIMIT=120

# MAGA 3.0: Rich Messages and styled inline buttons (Bot API 10.3).
# Set 0 to use legacy photo/text home if a Telegram client looks unusual.
MAGA_RICH_UI=1
